# Copiar este archivo a ".env" (mismo nivel, en la raíz del repo) y completar
# con los valores del proyecto Supabase: Project Settings → API.
#
# SUPABASE_SERVICE_ROLE_KEY tiene permisos totales sobre la base — usarla
# SOLO en este script de migración, que corre localmente. Nunca pegarla en
# app/panel_semaforo.html ni en ningún código que se ejecute en el navegador.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
